# Optional. Without it, Ask Luciano answers from the local knowledge base only.
# Create a token at https://huggingface.co/settings/tokens (read access is enough)
# and set it here locally, and as an environment variable on Vercel for production.
HUGGINGFACE_API_TOKEN=

# Optional overrides — sensible defaults are baked in.
# HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HUGGINGFACE_API_URL=https://router.huggingface.co/v1/chat/completions
